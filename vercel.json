{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{frontend/**,node_modules/**,devided-math/**,resource/**,data/**,output/**,docs/**,tests/**,scripts/**,supabase/**,.git/**,.venv/**,.pytest_cache/**,.ruff_cache/**,.playwright-cli/**,**/__pycache__/**}"
    }
  },
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {"source": "/api/v1/:path*", "destination": "/api/index"},
    {"source": "/((?!api/|assets/).*)", "destination": "/index.html"}
  ]
}
