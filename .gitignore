# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage/
htmlcov/

# Secrets and local environment
.env
.env.*
!.env.example
# npm/Git credentials can carry tokens; force-add any shared config instead.
.npmrc
.netrc

# Node / frontend build output
node_modules/
frontend/dist/
*.tsbuildinfo

# Local databases, uploads and generated backups.
# SQLite files are matched by extension, not depth: LOCAL_DATABASE and the
# test/tmp runs live at data/, tmp/, tmp/<name>/ and the repo root.
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.db
*.db-*
data/uploads/
data/assets/
output/

# Local-only one-click launcher (kept out of git on purpose)
/start-local.cmd

# Local test / migration scratch files.
# tmp/math2/inventory.json is tracked, so do not ignore the whole tmp directory.
tmp/agent-*
tmp/text-*
tmp/migration-*
tmp/start-check*
tmp/ui*
tmp/e2e*

# Supabase CLI, Vercel and Playwright local state
supabase/.temp/
supabase/.branches/
.vercel/
.playwright-cli/
test-results/
playwright-report/

# Logs, OS files, editor state and merge leftovers
*.log
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.orig
*.rej
*.bak
*~
.idea/
.vscode/
