# local: SQLite development; supabase: hosted Auth / Data API / Storage
APP_MODE=local
APP_ORIGIN=http://127.0.0.1:8011
LOCAL_DATABASE=data/mathonline.sqlite
# Local draft preview is never enabled in Supabase mode.
LOCAL_PREVIEW_DRAFTS=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=mathonline

# Server-only resource reward. Set to your Quark share URL and extraction code.
# Leave empty to keep downloads unavailable until the resource is ready.
RESOURCE_DOWNLOAD_URL=
RESOURCE_EXTRACTION_CODE=


# AI 判分/学情分析/生题（OpenAI 兼容接口）。三项全空时相关功能明确降级，不阻断提交。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=30
# 可选：考试预测蓝图单独用快速模型（留空沿用 AI_MODEL）。
AI_BLUEPRINT_MODEL=
# 可选：思考型模型设为 none 关闭思考（例如本地 Ollama qwen3）；留空不发送该字段。
AI_REASONING_EFFORT=
# AI 仿题共享题池：supabase 模式默认开启，本地默认关闭；可显式 on/off。
AI_VARIANT_SHARE=
AI_VARIANT_POOL_SIZE=3
