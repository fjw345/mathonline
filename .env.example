# local: SQLite development; supabase: hosted Auth / Data API / Storage
APP_MODE=local
APP_ORIGIN=http://127.0.0.1:8011
LOCAL_DATABASE=data/mathonline.sqlite
# Local draft preview is never enabled in Supabase mode.
LOCAL_PREVIEW_DRAFTS=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=mathonline

# Server-only resource reward. Set to your Quark share URL and extraction code.
# Leave empty to keep downloads unavailable until the resource is ready.
RESOURCE_DOWNLOAD_URL=
RESOURCE_EXTRACTION_CODE=


# AI 判分/学情分析/生题（OpenAI 兼容接口）。三项全空时相关功能明确降级，不阻断提交。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 单次模型请求超时秒数；生题/组卷建议不低于 90，默认 30 会让强模型生题超时。
AI_TIMEOUT=30
# 可选：考试预测蓝图单独用快速模型（留空沿用 AI_MODEL）。
AI_BLUEPRINT_MODEL=
# 可选：AI 生题（仿题/模拟卷 AI 题）单独用更强模型（留空沿用 AI_MODEL）。
AI_VARIANT_MODEL=
# 可选：思考型模型设为 none 关闭思考（例如本地 Ollama qwen3）；留空不发送该字段。
AI_REASONING_EFFORT=
# 图片作答转写：需要一个支持图片输入的模型；留空沿用上面的 AI 配置。
# 可单独指向另一家兼容端点（例如文本走云端、图片走本地视觉模型）。
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=
AI_VISION_TIMEOUT=120
# AI 仿题共享题池：supabase 模式默认开启，本地默认关闭；可显式 on/off。
AI_VARIANT_SHARE=
AI_VARIANT_POOL_SIZE=3
# 用户自带 DeepSeek API 密钥的加密密钥：base64url 编码的 32 字节。
# 生成：python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# 留空时用户无法保存密钥，AI 功能会明确提示管理员配置；不要提交真实值。
AI_KEY_SECRET=
# 本地开发/测试可设为 on，让未配置密钥的用户回退 AI_API_KEY；supabase 模式默认关闭。
AI_ALLOW_SERVER_KEY=
